[Unit]
Description=Bugcrowd CrowdStream Discord bot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=crowdstream
Group=crowdstream
WorkingDirectory=/opt/bugcrowd-crowdstream-discord
EnvironmentFile=/etc/bugcrowd-crowdstream-discord.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/bugcrowd-crowdstream-discord/.venv/bin/python main.py
TimeoutStartSec=2h
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bugcrowd-crowdstream-discord
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
